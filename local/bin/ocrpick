#!/usr/bin/env bash
# ocrpick: maim 框选区域 -> tesseract 识别（中英）-> 文本进剪贴板
png="$HOME/.cache/ocrpick.png"
mkdir -p "$HOME/.cache"
maim -s "$png" || exit 0
text=$(tesseract-ocr "$png" - -l chi_sim+eng --psm 6 2>/dev/null | sed '/^[[:space:]]*$/d')
if [ -z "$text" ]; then
    dunstify -a ocrpick -u critical "没识别出文字"
    exit 1
fi
printf '%s' "$text" | xclip -selection clipboard
preview="${text:0:80}"
dunstify -a ocrpick -u low -t 8000 "已复制: $preview"
